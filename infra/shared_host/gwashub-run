#!/usr/bin/env bash
# Run a command from this release's virtualenv with GWASHub's settings:
#
#     gwashub-run uvicorn gwashub_api.main:app ...
#     gwashub-run python -m gwashub_api.admin invite ...
#
# The settings come from the env file (/etc/gwashub/env, or GWASHUB_ENV_FILE), written by devtools/shared_host.py. The
# file is read as data and never run: blank lines and lines starting with # are skipped, and every other line must be
# exactly KEY='value', whose value is passed on as written, with nothing in it expanded. Any other line stops the wrapper
# before it runs anything; the message gives the line's number, never its content, which may be a secret.
# The settings reach the command only, never this script's own variables. A GWASHUB_AUTH line is ignored, and the sign-in
# mode and the module search path are set after the file, so nothing in it (or in the caller's environment) can turn on
# the development sign-in, which lets anyone in by typing an email address.
# If the env file is missing or has a bad line, nothing runs.
set -euo pipefail

if [ "$#" -lt 1 ]; then
    echo "usage: gwashub-run <command in the release's .venv/bin> [arguments...]" >&2
    exit 2
fi
command_name=$1
shift

env_file=${GWASHUB_ENV_FILE:-/etc/gwashub/env}
if [ ! -r "$env_file" ]; then
    echo "gwashub-run: cannot read the env file $env_file" >&2
    exit 1
fi

line_re="^([A-Za-z_][A-Za-z0-9_]*)='([^']*)'$"
settings=()  # KEY=value words for env(1): never assigned in this shell
number=0
while IFS= read -r line || [ -n "$line" ]; do
    number=$((number + 1))
    if [[ $line =~ ^[[:space:]]*$ || $line == \#* ]]; then
        continue
    fi
    if [[ ! $line =~ $line_re ]]; then
        echo "gwashub-run: line $number of $env_file is not KEY='value': not running anything" >&2
        exit 1
    fi
    if [ "${BASH_REMATCH[1]}" = GWASHUB_AUTH ]; then
        echo "gwashub-run: ignoring GWASHUB_AUTH on line $number of $env_file: the sign-in is always cognito here" >&2
        continue
    fi
    settings+=("${BASH_REMATCH[1]}=${BASH_REMATCH[2]}")
done < "$env_file"

# This file is <release>/infra/shared_host/gwashub-run; /opt/gwashub/current is a symlink to a release.
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
RELEASE=$(readlink -f "$here/../..")

cd "$RELEASE"
# The settings first, then the two the wrapper decides: env(1) applies them in order, so the last one for a name wins.
exec env ${settings[@]+"${settings[@]}"} GWASHUB_AUTH=cognito "PYTHONPATH=$RELEASE:$RELEASE/api" \
    "$RELEASE/.venv/bin/$command_name" "$@"
