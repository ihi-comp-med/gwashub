#!/usr/bin/env bash
# Run a command from this release's virtualenv with GWASHub's settings:
#
#     gwashub-run uvicorn gwashub_api.main:app ...
#     gwashub-run python -m gwashub_api.admin invite ...
#
# The settings come from the env file (/etc/gwashub/env, or GWASHUB_ENV_FILE), written by devtools/shared_host.py.
# The sign-in mode and the module search path are set AFTER it is read, so nothing in the file (or in the caller's
# environment) can turn on the development sign-in, which lets anyone in by typing an email address.
# If the env file is missing or broken, nothing runs.
set -euo pipefail

if [ "$#" -lt 1 ]; then
    echo "usage: gwashub-run <command in the release's .venv/bin> [arguments...]" >&2
    exit 2
fi
command_name=$1
shift

# This file is <release>/infra/shared_host/gwashub-run; /opt/gwashub/current is a symlink to a release.
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
RELEASE=$(readlink -f "$here/../..")

env_file=${GWASHUB_ENV_FILE:-/etc/gwashub/env}
if [ ! -r "$env_file" ]; then
    echo "gwashub-run: cannot read the env file $env_file" >&2
    exit 1
fi

set -a
# shellcheck source=/dev/null
. "$env_file"
set +a

export GWASHUB_AUTH=cognito
export PYTHONPATH="$RELEASE:$RELEASE/api"

cd "$RELEASE"
exec "$RELEASE/.venv/bin/$command_name" "$@"
